{
  "name": "eshop-monorepo",
  "version": "1.0.0",
  "description": "E-Shop Full-Stack E-Commerce Application",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install --include=dev",
    "install:all": "npm run install:server && npm run install:client",
    "build": "npm run install:all && cd client && npm run build",
    "seed": "cd server && npm run seed",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "test": "cd server && npm test",
    "start": "node server/src/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ecommerce",
    "eshop",
    "react",
    "express",
    "mongodb"
  ],
  "author": "E-Shop Team",
  "license": "ISC"
}

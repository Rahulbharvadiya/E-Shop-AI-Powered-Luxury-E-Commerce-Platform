# Server Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
# Replace with your local or MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/eshop?retryWrites=true&w=majority

# Authentication Secrets (Must be at least 16 characters long)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_16_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_16_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Initial Super Admin Seed (Optional, used during database seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!
ADMIN_USERNAME=admin
ADMIN_PHONE=9876543210

# Delivery Intelligence Defaults
WAREHOUSE_PINCODE=560001
DEFAULT_USER_PINCODE=560035
FREE_DELIVERY_ABOVE=499
DELIVERY_FEE=40

# Email Verification & Notifications (Optional SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# MAIL_FROM="E-Shop" <no-reply@eshop.com>

# AI Shopping Concierge (Optional Google Gemini API Key)
# GEMINI_API_KEY=your_gemini_api_key_here
